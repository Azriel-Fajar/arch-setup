# Generated by matugen (template: ~/.config/matugen/templates/mako-config). Edit the template, not this file.
width=420
height=44
margin=10
outer-margin=6
padding=8,22
border-size=1
border-radius=22
anchor=top-center
layer=overlay
default-timeout=1000
ignore-timeout=1
font=JetBrains Mono 10.5
background-color={{colors.surface_container.default.hex}}d9
border-color={{colors.outline_variant.default.hex}}
text-color={{colors.on_surface_variant.default.hex}}
progress-color=over {{colors.primary_container.default.hex}}

# Icon: small round dot-sized, left of text
icons=1
max-icon-size=24
icon-location=left
icon-border-radius=12

# Single line pill: bold accent title, soft body
markup=1
format=<span weight="bold" foreground="{{colors.primary.default.hex}}">%s</span>  %b

[grouped]
format=<span weight="bold" foreground="{{colors.primary.default.hex}}">%s</span>  %b  <span size="small" foreground="{{colors.outline.default.hex}}">(%g)</span>

[urgency=low]
border-color={{colors.outline_variant.default.hex}}
format=<span weight="bold" foreground="{{colors.tertiary.default.hex}}">%s</span>  %b
default-timeout=1000

[urgency=normal]
default-timeout=1000

[urgency=critical]
border-size=2
border-color={{colors.error.default.hex}}
background-color={{colors.error_container.default.hex}}e6
text-color={{colors.on_error_container.default.hex}}
format=<span weight="bold" foreground="{{colors.error.default.hex}}">⚠ %s</span>  %b
default-timeout=0

[app-name=XAMPP]
border-color={{colors.tertiary.default.hex}}
default-timeout=1000
