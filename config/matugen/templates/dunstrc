# Generated by matugen (template: ~/.config/matugen/templates/dunstrc). Edit the template, not this file.
[global]
    # Never pause timeouts when user is idle
    idle_threshold = 0
    # Pill at top center, shrinks to content up to max width
    origin = top-center
    offset = (0, 12)
    width = (0, 420)
    height = (0, 44)
    notification_limit = 5
    gap_size = 6
    padding = 12
    horizontal_padding = 22
    text_icon_padding = 10
    frame_width = 1
    corner_radius = 22
    separator_height = 0
    layer = overlay

    font = JetBrains Mono 10.5
    markup = full
    format = "<b><span foreground='{{colors.primary.default.hex}}'>%s</span></b>  %b"
    alignment = left
    vertical_alignment = center
    word_wrap = no
    ellipsize = end
    ignore_newline = yes
    stack_duplicates = true
    show_indicators = no

    icon_position = left
    min_icon_size = 0
    max_icon_size = 24
    icon_corner_radius = 12

    progress_bar = true
    progress_bar_corner_radius = 4
    progress_bar_frame_width = 0

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "{{colors.surface_container.default.hex}}d9"
    foreground = "{{colors.on_surface_variant.default.hex}}"
    frame_color = "{{colors.outline_variant.default.hex}}"
    highlight = "{{colors.primary_container.default.hex}}"
    format = "<b><span foreground='{{colors.tertiary.default.hex}}'>%s</span></b>  %b"
    timeout = 1

[urgency_normal]
    background = "{{colors.surface_container.default.hex}}d9"
    foreground = "{{colors.on_surface_variant.default.hex}}"
    frame_color = "{{colors.outline_variant.default.hex}}"
    highlight = "{{colors.primary_container.default.hex}}"
    timeout = 1

[urgency_critical]
    background = "{{colors.error_container.default.hex}}e6"
    foreground = "{{colors.on_error_container.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
    highlight = "{{colors.error.default.hex}}"
    format = "<b><span foreground='{{colors.error.default.hex}}'>⚠ %s</span></b>  %b"
    timeout = 3

[xampp]
    appname = XAMPP
    frame_color = "{{colors.tertiary.default.hex}}"

[force_expire]
    appname = "*"
    override_dbus_timeout = 3

[screenshot]
    summary = "Screenshot*"
    override_dbus_timeout = 1

# Chrome puts site domain as first body line; script re-sends cleaned copy and closes original
[chrome_strip_domain]
    appname = "Google Chrome"
    script = ~/.config/dunst/scripts/chrome-strip-domain.sh
    # Original only exists for a moment (script closes it); render it invisible
    background = "#00000000"
    foreground = "#00000000"
    format = "%s"
    frame_color = "#00000000"
    highlight = "#00000000"
