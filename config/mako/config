# Generated by matugen (template: ~/.config/matugen/templates/mako-config). Edit the template, not this file.
width=420
height=44
margin=10
outer-margin=6
padding=8,22
border-size=1
border-radius=22
anchor=top-center
layer=overlay
default-timeout=1000
ignore-timeout=1
font=JetBrains Mono 10.5
background-color=#201f25d9
border-color=#47464f
text-color=#c8c5d0
progress-color=over #444078

# Icon: small round dot-sized, left of text
icons=1
max-icon-size=24
icon-location=left
icon-border-radius=12

# Single line pill: bold accent title, soft body
markup=1
format=<span weight="bold" foreground="#c5c0ff">%s</span>  %b

[grouped]
format=<span weight="bold" foreground="#c5c0ff">%s</span>  %b  <span size="small" foreground="#928f99">(%g)</span>

[urgency=low]
border-color=#47464f
format=<span weight="bold" foreground="#ebb9d0">%s</span>  %b
default-timeout=1000

[urgency=normal]
default-timeout=1000

[urgency=critical]
border-size=2
border-color=#ffb4ab
background-color=#93000ae6
text-color=#ffdad6
format=<span weight="bold" foreground="#ffb4ab">⚠ %s</span>  %b
default-timeout=0

[app-name=XAMPP]
border-color=#ebb9d0
default-timeout=1000
